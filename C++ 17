#include <iostream>

using namespace std;

//statyczne zmienne członkowskie
//Są to elementy wspólne dla wszystkich obiektów klasy // static nie równa się const statyczne jest do wszystkich ale zmienny element


// Definicja klasy 
class Pracownik {
public: //specyfikator dostępu
	//Deklaracje statycznych zmiennych członkowskich
	static string s_szkola;
	//deklaracje zmiennych
	string imie, nazwisko;
	//Prototyp (deklaracja) funkcji członkowskich (metod)

	void wyswietlDane();
};

//Inicjalizacja zmiennych statycznych
// :: - operator zakresu
string Pracownik::s_szkola = "Technikum SPSK";

